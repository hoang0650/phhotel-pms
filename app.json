{
  "expo": {
    "name": "PHHotel PMS",
    "slug": "phhotel-pms-interface",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/phgroup_logo_circle.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "appleTeamId": "XZUV4HFW8S",
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.phhotel-pms-interface",
      "associatedDomains": [
        "applinks:phhotel.vn",
        "appclips:phhotel.vn"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "PHHotel PMS uses motion data only when required by shared frameworks to keep the interface responsive on your device.",
        "NSLocalNetworkUsageDescription": "PHHotel PMS kết nối OpenClaw gateway trên mạng nội bộ hoặc LAN khi bạn mở trợ lý AI.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "phhotel.vn": {
              "NSIncludesSubdomains": true,
              "NSExceptionRequiresForwardSecrecy": false,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2"
            },
            "openclaw.phhotel.vn": {
              "NSIncludesSubdomains": true,
              "NSExceptionRequiresForwardSecrecy": false,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2"
            },
            "ai.phhotel.vn": {
              "NSExceptionRequiresForwardSecrecy": false,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2"
            }
          }
        },
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "rork-app"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.321108577244-p1tp873s03sc3rmhc18b6tl0g8f0h1r4"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.phhotel_pms_interface",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://phhotel.vn/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "./plugins/withOpenClawNetworkSecurity.js",
      "@bacons/apple-targets",
      "expo-image",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://phhotel.vn/"
      },
      "eas": {
        "projectId": "a6701f0c-abda-4422-a777-e95e502857bf"
      }
    }
  }
}
