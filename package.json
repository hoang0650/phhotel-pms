{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npx.cmd expo start --tunnel",
    "start:lan": "npx.cmd expo start --clear",
    "start-web": "npx.cmd expo start --web --clear",
    "start-web-dev": "cross-env DEBUG=expo* npx.cmd expo start --web --clear",
    "build:web": "npx.cmd expo export -p web",
    "build:zalo": "npx.cmd expo export -p web",
    "build:android": "npx.cmd --yes eas-cli@latest build --platform android --profile production",
    "build:android:preview": "npx.cmd --yes eas-cli@latest build --platform android --profile preview",
    "build:ios": "npx.cmd --yes eas-cli@latest build --platform ios --profile production",
    "build:ios:preview": "npx.cmd --yes eas-cli@latest build --platform ios --profile preview",
    "submit:android": "npx.cmd --yes eas-cli@latest submit --platform android --profile production --latest",
    "submit:ios": "npx.cmd --yes eas-cli@latest submit --platform ios --profile production",
    "serve:web": "npx.cmd expo serve",
    "lint": "npx.cmd expo lint"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@nkzw/create-context-hook": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rork-ai/toolkit-sdk": "^0.2.51",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.83.0",
    "@ungap/structured-clone": "^1.3.0",
    "date-fns": "^4.1.0",
    "expo": "^57.0.19",
    "expo-application": "~57.0.2",
    "expo-auth-session": "~57.0.11",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.15",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.15",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^0.475.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.4",
    "eas-cli": "^20.5.1",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
